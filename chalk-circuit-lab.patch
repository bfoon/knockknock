+    return {
+      v: 1, mode: mode === "kid" ? "kid" : "pro",
+      parts: [], wires: [], code: "", blocks: null, prog: "code",
+      view: { x: 0, y: 0, z: 1 }
+    };
+  };
+
+  /* --------------------------------------------------------------- bus */
+
+  var handlers = {};
