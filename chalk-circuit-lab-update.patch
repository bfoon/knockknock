+    while (i < n && j < m) {
+      if (a[i] === b[j]) { ops.push({ k: "=", a: a[i], ia: i }); i++; j++; }
+      else if (t[i + 1][j] >= t[i][j + 1]) { ops.push({ k: "-", a: a[i], ia: i }); i++; }
+      else { ops.push({ k: "+", b: b[j] }); j++; }
