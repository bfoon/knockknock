+        self.assertEqual((m["b"]["playing"], m["b"]["current"]["id"]), (False, "aqz-KE-bpKQ"))
+
+    def test_cdj_cue_bpm_sync_duration(self):
+        self.act(action="load", url="dQw4w9WgXcQ", mode="audio")
