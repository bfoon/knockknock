+      if (/^\s+$/.test(v2.slice(s2, p2)) && p2 - s2 >= 2) {
+        e.preventDefault();
+        ta.setSelectionRange(p2 - 2, p2);
+        document.execCommand("insertText", false, "}");
+      }
+    }
+  };
+})(typeof window !== "undefined" ? window : globalThis);
