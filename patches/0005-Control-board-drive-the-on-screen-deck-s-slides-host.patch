+    /* Host slide control. The control board opens its own connection to the
+       deck that's on screen (pin "screen:<token>", checked by the deck
+       socket) and drives it like a phone controller would. It works with or
+       without the slide remote's lock: when a phone or remote fails, the
+       host can always carry on from here. */
+    const hostCtl = {
+      code:"", sock:null, ok:false, i:0, slides:[], seq:0, retry:0, timer:null, gen:0, err:"",
+      want(code){
+        code = code || "";
+        if(code === this.code) return;
+        this.close(); this.code = code; this.ok = false; this.slides = []; this.i = 0; this.seq = 0; this.err = "";
+        if(code) this.open();
+        this.paint();
+      },
+      close(){
+        this.gen++; clearInterval(this.timer); this.timer = null;
+        try{ this.sock && this.sock.close(); }catch(e){}
+        this.sock = null;
+      },
+      open(){
+        const gen = ++this.gen, code = this.code;
+        let ws;
+        try{ ws = new WebSocket((location.protocol === "https:" ? "wss://" : "ws://") + location.host + `/ws/hanns/${code}/`); }
+        catch(e){ return this.again(gen); }
+        this.sock = ws;
+        ws.onopen = ()=>{
+          if(gen !== this.gen) return;
+          this.retry = 0;
+          ws.send(JSON.stringify({type:"controller_hello", pin:"screen:" + token}));
+          clearInterval(this.timer);
+          this.timer = setInterval(()=>{ try{ ws.send('{"type":"ping"}'); }catch(e){} }, 20000);
+        };
+        ws.onmessage = ev=>{
+          if(gen !== this.gen) return;
+          let m; try{ m = JSON.parse(ev.data); }catch(e){ return; }
+          if(m.type === "ping"){ try{ ws.send('{"type":"pong"}'); }catch(e){} return; }
+          if(m.type === "controller_ok"){
+            this.ok = true; this.err = "";
+            if(Array.isArray(m.slides)) this.slides = m.slides;
+            if(typeof m.seq === "number") this.seq = m.seq;
+            this.i = Number(m.current_slide) || 0;
+            this.paint(true);
+          }else if(m.type === "controller_denied"){
+            this.ok = false; this.err = "Can't reach this deck";
+            this.paint();
+          }else if(m.type === "goto" && typeof m.index === "number"){
+            if(typeof m.seq === "number"){ if(m.seq <= this.seq) return; this.seq = m.seq; }
+            this.i = m.index; this.paint();
+          }
+        };
+        ws.onclose = ()=>{ if(gen === this.gen){ this.ok = false; this.paint(); this.again(gen); } };
+      },
+      again(gen){
+        if(gen !== this.gen || !this.code) return;
+        this.retry++;
+        setTimeout(()=>{ if(gen === this.gen && this.code) this.open(); }, Math.min(1000 * this.retry, 8000));
+      },
+      go(index){
+        if(!this.ok || !this.sock || this.sock.readyState !== 1) return;
+        const n = this.slides.length;
+        index = Math.max(0, Math.min(index, n - 1));
+        if(index === this.i) return;
+        this.i = index;                       // move the board at once; the room follows the socket
+        this.sock.send(JSON.stringify({type:"goto", index}));
+        this.paint();
+      },
+      label(sl, k){
+        const els = (sl && sl.els) || [];
+        const t = els.find(e => e && e.type === "text" && String(e.text || e.html || "").trim());
+        const txt = t ? String(t.text || t.html || "").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim() : "";
+        return `${k + 1}${txt ? " · " + (txt.length > 34 ? txt.slice(0, 34) + "…" : txt) : ""}`;
+      },
+      paint(rebuild){
+        root.querySelectorAll("[data-host]").forEach(box=>{
+          const n = this.slides.length, ready = this.ok && n > 0;
+          const prev = box.querySelector('[data-host-act="prev"]'), next = box.querySelector('[data-host-act="next"]');
+          const sel = box.querySelector("select"), st = box.querySelector(".st");
+          prev.disabled = !ready || this.i <= 0;
+          next.disabled = !ready || this.i >= n - 1;
+          sel.disabled = !ready;
+          if(rebuild || sel.options.length !== n){
+            sel.innerHTML = ready ? this.slides.map((sl, k)=>`<option value="${k}">${esc(this.label(sl, k))}</option>`).join("")
+                                  : `<option>${this.code ? "Connecting…" : "—"}</option>`;
+          }
+          if(ready) sel.value = String(this.i);
+          const lock = state.remote && state.remote.lock && state.remote.device;
+          st.className = "st" + (ready ? " on" : this.err ? " bad" : "");
+          st.textContent = ready ? `Slide ${this.i + 1} / ${n}${lock ? " · overrides " + state.remote.device.name : ""}`
+                                 : (this.err || "Connecting…");
+        });
+      },
+    };
+    function hostControls(){
+      return `<div class="bs-host" data-host role="group" aria-label="Drive the slides from here">
+          <span class="k"><i class="bi bi-display"></i> From here</span>
+          <button type="button" data-host-act="prev" aria-label="Previous slide" title="Previous slide">‹</button>
+          <select aria-label="Jump to slide"><option>Connecting…</option></select>
+          <button type="button" data-host-act="next" aria-label="Next slide" title="Next slide">›</button>
+          <span class="st" aria-live="polite">Connecting…</span>
+        </div>`;
+    }
+    root.addEventListener("change", ev=>{
+      if(ev.target.matches("[data-host] select")) hostCtl.go(Number(ev.target.value));
+    });
+
