+x=load('bt_dimmer'); bt=x.pt('hc05'); led=x.pt('led'); x.sim.bt={}; x.sim.bt[bt.id]=true; x.adv(0.2);
+x.sim.phoneSend(bt.id,'v255\n'); x.adv(0.4); const hi=st(x,led).b;
+x.sim.phoneSend(bt.id,'v40\n'); x.adv(0.4); const lo=st(x,led).b;
