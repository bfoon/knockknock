+/* The lobby's drifting light. It used to be three gradients under a live 70px
+   blur with mix-blend-mode — re-blurred on every frame anything moved on the
+   projector (measured: most of the frame time during a transition on a
+   modest laptop). Now the softness is in the gradients themselves and the
+   blobs only drift with transforms, which the GPU does for free. Same colours,
+   same places, same drift. */
+.scr-aurora{position:absolute;inset:-20%;pointer-events:none}
 .scr-aurora i{
-  position:absolute;border-radius:50%;mix-blend-mode:screen;
+  position:absolute;border-radius:50%;will-change:transform;
   animation:scrDrift 26s ease-in-out infinite alternate;
 }
