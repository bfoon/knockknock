+        self.assertEqual((m["b"]["current"]["id"], m["queue"]), ("aqz-KE-bpKQ", []))
+        self.assertEqual(self.act(action="load_queued", deck="b", key=key)[0].status_code, 400)
+        self.act(action="play", deck="b")
