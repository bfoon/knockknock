+      var n = e.target.closest("[data-ln]");
+      if (!n) return;
+      var ln = +n.getAttribute("data-ln");
+      if (self.breaks[ln]) delete self.breaks[ln]; else self.breaks[ln] = true;
+      self.gutter();
+      if (self.opts.onBreaks) self.opts.onBreaks(self.breaks);
